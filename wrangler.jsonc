{
  "name": "my-note-web",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-01",
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" },
  "routes": [{ "pattern": "note.19980803.xyz", "custom_domain": true }],
  // 每小時對帳一次：webhook 失效時照樣會補齊內容，也用來分批補完舊筆記的 updatedAt。
  "triggers": { "crons": ["0 * * * *"] },
  "kv_namespaces": [{ "binding": "NOTES", "id": "d48ef8aab78046eda232f444fb902e12" }],
  "ai": { "binding": "AI" },
  "vars": {
    "GITHUB_REPO": "hsjinde/my-note",
    "GITHUB_BRANCH": "main",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  }
}
